// {{ class_name }}.generated.h
#pragma once

#include <nlohmann/json.hpp>
#include "JsonConverter.h"
#include <string>

{{ # 名前空間を含む型名を返す }}
{{- func get_fully_qualified_type(member)
	if member.name_space == ""
		ret member.type_name
	else
		ret member.name_space + "::" + member.type_name
	end
end
}}

// ============================================================================
// {{ class_name }}の状態を保存するState構造体の定義、Undo/Redoに使うMementoのusing宣言
// ============================================================================
struct {{ class_name }}State
{
	{{- for member in properties}}
		{{ get_fully_qualified_type(member) }} {{ member.name }};
	{{- end }}
};

// クラスの前方宣言
{{- if name_space == "" }}
	class {{ class_name }};
{{- else }}
	namespace {{ name_space }}
	{{ "{" }}
		class {{ class_name }};
	{{ "}" }}
{{- end}}

{{ # 名前空間付きの完全名 }}
{{ fully_qualified_name = "" }}
{{- if name_space == "" }}
	{{ fully_qualified_name = $"{ class_name }" }}
{{- else }}
	{{ fully_qualified_name = $"{name_space}::{ class_name }" }}
{{- end }}

using {{ class_name }}Memento = mtgb::ComponentMemento<{{ fully_qualified_name }}, {{ class_name }}State>;

// ============================================================================
// {{ class_name }}と{{ class_name }}Mementoの相互変換処理を実装
// ============================================================================
#define MT_GENERATED_BODY_{{ class_name }}() \
	public: \
	using Memento = {{ class_name }}Memento; \
	{{ class_name }}Memento* SaveToMemento(); \
	\
	void RestoreFromMemento(const Memento& _memento); \
	\
	friend struct {{ class_name }}_Register; \
	friend void to_json(nlohmann::json& _j,const {{ class_name }}& _target); \
	friend void from_json(const nlohmann::json& _j, {{ class_name }}& _target); \
	\
	static std::string TypeName(){ return "{{ class_name }}" ;} \
	/* ImGui表示処理の登録 */ \
	static void RegisterImGui(); \

#pragma warning(push)
#pragma warning(disable:4005)
// マクロ上書き
#define MT_GENERATED_BODY() MT_GENERATED_BODY_{{ class_name }}()
#pragma warning(pop)