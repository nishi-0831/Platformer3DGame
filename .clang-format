---
BasedOnStyle: Microsoft
Language: Cpp
Standard: c++20

# includeファイルをソートするか
SortIncludes: Never
# インデント幅
IndentWidth: 4
# タブを使用するか
UseTab: Always
# タブの幅
TabWidth: 4
# 名前空間のインデント
NamespaceIndentation: All

# ブレース{}のスタイル
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: true
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterObjCDeclaration: true
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: true
  # Before<> : <>の前で改行するか
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  BeforeWhile: true
  # ブレースをインデントするか
  IndentBraces: false
  SplitEmptyFunction: true
  SplitEmptyRecord: true
  SplitEmptyNamespace: true

# ポインタ・参照の配置
PointerAlignment: Left
ReferenceAlignment: Left

# 行の最大長(0の場合上限なし)
ColumnLimit: 120

# 改行設定
BinPackParameters: false
BinPackArguments: false

# 関数宣言・呼び出し時、一行に収まりきらない場合は複数行に並べるか
AllowAllArgumentsOnNextLine: false
AllowAllParametersOfDeclarationOnNextLine: false
# 短いブロックでも一行にまとめない
AllowShortLambdasOnASingleLine: None
AllowShortBlocksOnASingleLine: Never
# 短い関数を一行にまとめるかどうか。 InlineOnly : インライン関数のみ一行にまとめる
AllowShortFunctionsOnASingleLine: InlineOnly
# 末尾のコメント行
AlignTrailingComments: true
# 変数への代入が連続した際に=で整列するか
AlignConsecutiveAssignments: true
# マクロの改行バックスラッシュの整列
AlignEscapedNewlines: LeftWithLastLine
# 開始括弧を置いた後の引数の並べ方
AlignAfterOpenBracket: BlockIndent
# 開始括弧の前にスペースを入れるか
SpaceBeforeParens: ControlStatements
# switch-caseのコロン前にスペースを入れるか
SpaceBeforeCaseColon: true
# 初期化子リストの前に空白を入れるか
SpaceBeforeCpp11BracedList: true
# メンバ初期化子リストのコロン前に空白を入れるか
SpaceBeforeCtorInitializerColon : true
# メンバ初期化子リストの波かっこの前後に空白を入れないか
# 例 false : vector<int> x{ 1, 2, 3, 4}; となる
Cpp11BracedListStyle: false
# コロン及びカンマの前で改行
BreakConstructorInitializers: BeforeComma
ConstructorInitializerIndentWidth: 4
ContinuationIndentWidth: 4

# コンセプトの前で改行するか
BreakBeforeConceptDeclarations: true
